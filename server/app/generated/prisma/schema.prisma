generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id                  String                                 @id @default(uuid())
  fullName            String
  email               String                                 @unique
  password            String?
  googleId            String?
  bio                 String?
  avatar              String?
  birthday            DateTime?
  location            Unsupported("geography(Point, 4326)")?
  gender              String?
  mood                String?
  avatar2             String?
  purpose             String?
  interest            String[]                               @default([])
  images              String[]                               @default([])
  instagram           String?
  facebook            String?
  createdAt           DateTime                               @default(now())
  recvMessages        Message[]                              @relation("received")
  sentMessages        Message[]                              @relation("sent")
  globalMessages      GlobalChatMessage[]                    @relation("UserGlobalMessages")
  privateRoomMessages PrivateRoomMessage[]                   @relation("UserPrivateRoomMessages")
}

model privacy {
  id                  String   @id @default(uuid())
  senderId            String
  receiverId          String
  instagramPreference Boolean? @default(false)
  facebookPreference  Boolean? @default(false)

  @@unique([senderId, receiverId])
}

model song {
  id        String @id @default(uuid())
  song_name String
  song_url  String
  duration  Int
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  createdAt  DateTime @default(now())
  seen       Boolean  @default(false)
  receiver   User     @relation("received", fields: [receiverId], references: [id])
  sender     User     @relation("sent", fields: [senderId], references: [id])
}

model connection {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String
  updatedAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Games {
  id   String @id @default(uuid())
  name String
  icon String
}

model EmojiCharades {
  id        String @id @default(uuid())
  questions String
  answer    String
}

model Scoring {
  id             String   @id @default(uuid())
  senderId       String
  receiverId     String
  senderAnswer   String[] @default([])
  receiverAnswer String[] @default([])
  senderScore    Int
  receiverScore  Int

  @@unique([senderId, receiverId])
}

model GlobalChats {
  id          String              @id @default(uuid())
  roomName    String              @unique
  roomImage   String?
  memberLists String[]            @default([])
  messages    GlobalChatMessage[]
}

model GlobalChatMessage {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String
  text      String
  createdAt DateTime    @default(now())
  sender    User        @relation("UserGlobalMessages", fields: [senderId], references: [id])
  room      GlobalChats @relation(fields: [roomId], references: [id])
}

model PrivateRoom {
  id          String               @id @default(uuid())
  createrId   String
  roomName    String               @unique
  roomImage   String?
  category    String?
  description String?
  memberLists String[]             @default([])
  messages    PrivateRoomMessage[]
}

model PrivateRoomMessage {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String
  text      String
  createdAt DateTime    @default(now())
  sender    User        @relation("UserPrivateRoomMessages", fields: [senderId], references: [id])
  room      PrivateRoom @relation(fields: [roomId], references: [id])
}
