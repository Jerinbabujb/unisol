generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id           String                                 @id @default(uuid())
  fullName     String
  email        String                                 @unique
  password     String?
  googleId     String?
  bio          String?
  avatar       String?
  birthday     DateTime?
  location     Unsupported("geography(Point, 4326)")?
  gender       String?
  mood         String?
  avatar2      String?
  purpose      String?
  interest     String[]                               @default([])
  images       String[]                               @default([])
  instagram    String?
  facebook     String?
  createdAt    DateTime                               @default(now())
  recvMessages Message[]                              @relation("received")
  sentMessages Message[]                              @relation("sent")
}

model privacy {
  id                  String   @id @default(uuid())
  senderId            String
  receiverId          String
  instagramPreference Boolean? @default(false)
  facebookPreference  Boolean? @default(false)

  @@unique([senderId, receiverId])
}

model song {
  id        String @id @default(uuid())
  song_name String
  song_url  String
  duration  Int
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  createdAt  DateTime @default(now())
  seen       Boolean  @default(false)
  receiver   User     @relation("received", fields: [receiverId], references: [id])
  sender     User     @relation("sent", fields: [senderId], references: [id])
}

model connection {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String
  updatedAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}
