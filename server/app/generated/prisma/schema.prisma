generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  password     String?
  googleId     String?
  bio          String?
  avatar       String?
  birthday     DateTime?
  location     String?
  gender       String?
  mood         String?
  purpose      String?
  interest     String[]  @default([])
  instagram    String?
  facebook     String?
  createdAt    DateTime  @default(now())
  recvMessages Message[] @relation("received")
  sentMessages Message[] @relation("sent")
}

model privacy {
  id                  String   @id @default(uuid())
  senderId            String
  receiverId          String
  instagramPreference Boolean? @default(false)
  facebookPreference  Boolean? @default(false)

  @@unique([senderId, receiverId])
}

model song {
  id        String @id @default(uuid())
  song_name String
  song_url  String
  duration  Int
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  createdAt  DateTime @default(now())
  seen       Boolean  @default(false)
  receiver   User     @relation("received", fields: [receiverId], references: [id])
  sender     User     @relation("sent", fields: [senderId], references: [id])
}

model connection {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String
  updatedAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}
