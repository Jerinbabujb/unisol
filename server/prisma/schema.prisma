generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [postgis, vector]
}

model User {
  id                String    @id @default(uuid())

  // Basic Info
  pronouns          String?
  fullName          String
  email             String    @unique
  password          String?
  googleId          String?
  mobileNumber      String?
  Age               String?

  // Profile & Socials (Updated for ProfilePage)
  bio               String?
  avatar            String?
  images            String[]  @default([]) // For the Photo Gallery
  mood              String?   // For the "Set Mood" feature
  instagram         String?   // For Social Links
  facebook          String?   // For Social Links
  interest          String[]  @default([]) // For Interests & Vibes
  blockedUsers      String[]  @default([])
  matchUsers        String[]  @default([])

  // Personal Details
  birthday          DateTime?
  gender            String?
  horoscope         String?
  purpose           String?

  // Dating / Matching
  prefferGender     String?  
  intentions        String?
  experienceLevel   String?
  preferredMatch    String[]  @default([])

  // Neurodivergent Preferences
  primaryNeurotype  String[]  @default([])
  status            String?
  attachmentStyle   String?
  beliefSystem      String?
  mbtiType          String?

  // Spotify / Music
  topArtists        String[]  @default([])
  favoriteGenres    String[]  @default([])

  // UI / App
  uiTheme           String?

  // Location
  location          Unsupported("geography(Point, 4326)")?

  // Activity
  isOnline          Boolean   @default(false)
  lastSeen          DateTime?
  profileCompleted  Boolean   @default(false)

  // Verification
  isVerified        Boolean   @default(false)
  emailVerified     Boolean   @default(false)

  embedding         Unsupported("vector(384)")?

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  // --- RELATIONS ---

  // Messaging
  recvMessages      Message[] @relation("received")
  sentMessages      Message[] @relation("sent")

  // Friend Requests (For FriendRequests Page)
  sentRequests      FriendRequest[] @relation("sentRequests")
  receivedRequests  FriendRequest[] @relation("receivedRequests")

  // Group Chats (For GroupsLists Page)
  globalMessages    GlobalChatMessage[] @relation("UserGlobalMessages")
  privateRoomMessages PrivateRoomMessage[] @relation("UserPrivateRoomMessages")
  
  // To track which rooms a user has joined
  joinedRooms       RoomMember[]


  // Personality Results (JSON for flexibility)
  attachmentResults Json?   // { avoidant: 20, anxious: 70, secure: 10 }
  loveLanguages     String[] // ["Physical Touch", "Quality Time"]
  humanDesign       String?  // "Projector"
  
  // To track if they've taken the tests
  testsCompleted    String[] @default([]) // ["mbti", "attachment"]
}

// Support model for Connection Requests
model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  status      String   @default("pending") // "pending", "accepted", "rejected"
  createdAt   DateTime @default(now())

  sender      User     @relation("sentRequests", fields: [senderId], references: [id])
  receiver    User     @relation("receivedRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

// Support model for Group Memberships
model RoomMember {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  role      String   @default("member") // "admin", "member"
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  // Assuming you have a Room model for globalRoom/privateRoom
  // room   Room     @relation(fields: [roomId], references: [id])
}
model privacy{
  id                    String  @id @default(uuid())
  senderId              String
  receiverId            String
  instagramPreference   Boolean? @default(false)
  facebookPreference    Boolean? @default(false)
  @@unique([senderId,receiverId])
}
model song {
  id           String   @id @default(uuid())
  song_name    String
  song_url     String
  duration     Int
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  image      String?
  createdAt  DateTime @default(now())
  seen       Boolean @default(false)
  receiver   User     @relation("received", fields: [receiverId], references: [id])
  sender     User     @relation("sent", fields: [senderId], references: [id])
}

model connection{

  id        String  @id @default(uuid())
  senderId   String
  receiverId String
  status     String 
  updatedAt  DateTime @default(now())

  @@unique([senderId,receiverId])
}


model Games{
  id        String  @id @default(uuid())
  name      String
  icon      String
}

model EmojiCharades{
  id    String @id @default(uuid())
  questions  String
  answer    String
}



model Scoring{
  id              String @id @default(uuid())
  senderId        String
  receiverId      String
  senderAnswer    String[] @default([])
  receiverAnswer  String[] @default([])
  senderScore     Int
  receiverScore   Int

  @@unique([senderId,receiverId])
}



model GlobalChats{
  id     String @id @default(uuid())
  roomName  String @unique
  roomImage  String?
  memberLists  String[] @default([])
  messages    GlobalChatMessage[]
}


model GlobalChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  sender    User        @relation("UserGlobalMessages", fields: [senderId], references: [id])
  room      GlobalChats @relation(fields: [roomId], references: [id])
}


model PrivateRoom{
  id     String @id @default(uuid())
  createrId String
  roomName  String @unique
  inviteToken  String @unique
  roomImage  String?
  category String?
  description String?
  memberLists  String[] @default([])
  messages    PrivateRoomMessage[]
}


model PrivateRoomMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  sender    User        @relation("UserPrivateRoomMessages", fields: [senderId], references: [id])
  room      PrivateRoom @relation(fields: [roomId], references: [id])
}
