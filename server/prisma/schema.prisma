generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [postgis]
}

model User {
  id                String    @id @default(uuid())

  // Basic Info
  fullName          String
  email             String    @unique
  password          String?
  googleId          String?
  mobileNumber      String?

  // Profile
  bio               String?
  avatar            String?
  avatar2           String?
  images            String[]  @default([])

  // Personal Details
  birthday          DateTime?
  gender            String?
  horoscope         String?
  mood              String?
  purpose           String?

  // Dating / Matching
  intentions        String?
  experienceLevel   String?
  preferredMatch    String[]  @default([])

  // Neurodivergent Preferences
  primaryNeurotype  String[]  @default([])
  status            String?
  attachmentStyle   String?
  beliefSystem      String?
  mbtiType          String?

  // Interests
  interest          String[]  @default([])
  topArtists        String[]  @default([])
  favoriteGenres    String[]  @default([])

  // UI / App
  uiTheme           String?

  // Socials
  instagram         String?
  facebook          String?

  // Location
  location          Unsupported("geography(Point, 4326)")?

  // Activity
  isOnline          Boolean   @default(false)
  lastSeen          DateTime?
  profileCompleted  Boolean   @default(false)

  // Verification
  isVerified        Boolean   @default(false)
  emailVerified     Boolean   @default(false)

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Messages
  recvMessages      Message[] @relation("received")
  sentMessages      Message[] @relation("sent")

  globalMessages    GlobalChatMessage[] @relation("UserGlobalMessages")
  privateRoomMessages PrivateRoomMessage[] @relation("UserPrivateRoomMessages")
}
model privacy{
  id                    String  @id @default(uuid())
  senderId              String
  receiverId            String
  instagramPreference   Boolean? @default(false)
  facebookPreference    Boolean? @default(false)
  @@unique([senderId,receiverId])
}
model song {
  id           String   @id @default(uuid())
  song_name    String
  song_url     String
  duration     Int
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  createdAt  DateTime @default(now())
  seen       Boolean @default(false)
  receiver   User     @relation("received", fields: [receiverId], references: [id])
  sender     User     @relation("sent", fields: [senderId], references: [id])
}

model connection{

  id        String  @id @default(uuid())
  senderId   String
  receiverId String
  status     String 
  updatedAt  DateTime @default(now())

  @@unique([senderId,receiverId])
}


model Games{
  id        String  @id @default(uuid())
  name      String
  icon      String
}

model EmojiCharades{
  id    String @id @default(uuid())
  questions  String
  answer    String
}



model Scoring{
  id              String @id @default(uuid())
  senderId        String
  receiverId      String
  senderAnswer    String[] @default([])
  receiverAnswer  String[] @default([])
  senderScore     Int
  receiverScore   Int

  @@unique([senderId,receiverId])
}



model GlobalChats{
  id     String @id @default(uuid())
  roomName  String @unique
  roomImage  String?
  memberLists  String[] @default([])
  messages    GlobalChatMessage[]
}


model GlobalChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  sender    User        @relation("UserGlobalMessages", fields: [senderId], references: [id])
  room      GlobalChats @relation(fields: [roomId], references: [id])
}


model PrivateRoom{
  id     String @id @default(uuid())
  createrId String
  roomName  String @unique
  inviteToken  String @unique
  roomImage  String?
  category String?
  description String?
  memberLists  String[] @default([])
  messages    PrivateRoomMessage[]
}


model PrivateRoomMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  sender    User        @relation("UserPrivateRoomMessages", fields: [senderId], references: [id])
  room      PrivateRoom @relation(fields: [roomId], references: [id])
}
